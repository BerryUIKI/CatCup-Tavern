{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "CatCup Tavern",
    "version": "0.3.0",
    "identifier": "dev.catcup.tavern",
    "build": {
        "frontendDist": "../ui"
    },
    "app": {
        "windows": [],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
        "externalBin": ["binaries/catcup-node"],
        "fileAssociations": [
            {
                "ext": ["catcup"],
                "name": "CatCupTavern.CharacterCard",
                "description": "CatCup Tavern character card",
                "role": "Editor"
            }
        ],
        "resources": {
            "bundle/server": "server",
            "bundle/web": "web"
        },
        "windows": {
            "nsis": {
                "installMode": "currentUser"
            }
        }
    }
}
