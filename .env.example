# Server
CATCUP_HOST=127.0.0.1
CATCUP_PORT=8000
# Absolute path recommended. Relative paths resolve from the process cwd.
# CATCUP_DATA_DIR=./data
CATCUP_LOG_LEVEL=info

# Allow first-run password setup from a non-loopback address.
# Keep false unless you know exactly why you need it.
CATCUP_ALLOW_REMOTE_SETUP=false
